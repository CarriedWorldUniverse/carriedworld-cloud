# /etc/accretion/ds4-server.env -- ds4-server launch parameters (accretion
# env-file layout, migrated 2026-08-07). The systemd unit parameterizes its
# ExecStart from these. POST /v1/models/select rewrites DS4_MODEL and, when
# the target model has a <model>.gguf.env sidecar, DS4_CTX /
# DS4_CACHE_BUDGET / DS4_EXTRA_FLAGS from that sidecar.
DS4_MODEL=/home/jacinta/src/ds4/gguf/DeepSeek-V4-Flash-0731-MXFP4_MOE-Q8_0.gguf
DS4_CTX=131072
# Informational mirror of the cache flag carried in DS4_EXTRA_FLAGS.
DS4_CACHE_BUDGET=70GB
DS4_EXTRA_FLAGS=--ssd-streaming --ssd-streaming-cache-experts 70GB
# KV prefix pinning (task 16) / embd mmap (task 22) / prefill quantum
# (2026-08-07) -- validation history in the unit file comments.
DS4_KV_PIN_MIN_HITS=2
DS4_EMBD_MMAP=1
DS4_SERVER_MIXED_PREFILL_QUANTUM=2048
# Where a select rewrites, and the extra scan dirs for /v1/models/available.
DS4_ENV_FILE=/etc/accretion/ds4-server.env
DS4_MODEL_DIRS=/home/jacinta/src/ds4/gguf:/data/gguf
# Admin token gating POST /v1/models/select. Read it here, never from logs.
ACCRETION_ADMIN_TOKEN=REDACTED-SEE-HOST
