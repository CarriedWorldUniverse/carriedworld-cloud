[Unit]
Description=carriedworld-cloud reconcile (diff-first, alert-before-apply)
Documentation=https://github.com/CarriedWorldUniverse/carriedworld-cloud/blob/main/hosting/reconcile/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Point at a real checkout of this repo, e.g. /opt/carriedworld-cloud.
WorkingDirectory=/opt/carriedworld-cloud
ExecStart=/opt/carriedworld-cloud/hosting/reconcile/reconcile.sh
Environment=RECONCILE_WEBHOOK_FILE=/etc/carriedworld/discord_webhook
# The ACTIVE skip-list lives in the repo (hosting/reconcile/skip-list) so every
# exclusion is version-controlled and reviewable. Override with a host-local
# path only for a genuine one-host exception.
Environment=RECONCILE_SKIP_FILE=/opt/carriedworld-cloud/hosting/reconcile/skip-list
User=carriedworld-reconcile
